{
  // ============================================================
  //  กฎความปลอดภัยของ Realtime Database — โปรเจกต์ psu-lasc-animal
  //  ติดตั้ง: Firebase Console → Realtime Database → แท็บ Rules
  //           วางทับของเดิม → กด Publish
  // ============================================================
  //
  //  โหมด: อนุมัติเป็นรายคน
  //  เข้าถึงข้อมูลได้ก็ต่อเมื่อ  ยืนยันอีเมลแล้ว  และ  มีชื่ออยู่ใน allowlist
  //  ไม่มีใครเข้าได้โดยอัตโนมัติ แม้จะใช้อีเมล @psu.ac.th ก็ตาม
  //
  //  ⚠️⚠️ ก่อนกด Publish ต้องใส่ UID ของตัวเองลง allowlist ก่อน ⚠️⚠️
  //       ไม่อย่างนั้นคุณจะเข้าถึงข้อมูลของตัวเองไม่ได้
  //       (ยังแก้ได้เสมอจากคอนโซล แต่เสียเวลาโดยใช่เหตุ)
  //
  //  ── วิธีอนุมัติคนเข้าใช้งาน ────────────────────────────────
  //     1. ให้เขากดเข้าสู่ระบบ 1 ครั้ง หน้าจอจะขึ้นรหัส User UID
  //        พร้อมปุ่มคัดลอก ให้เขาส่งรหัสนั้นมาให้คุณ
  //        (หรือคุณดูเองที่ Authentication → Users คอลัมน์ User UID)
  //     2. Realtime Database → แท็บ Data → กด + เพิ่มข้อมูล
  //              allowlist / <User UID ที่ได้มา>  :  true
  //        ค่าต้องเป็น true แบบ boolean ไม่ใช่ข้อความ "true"
  //     3. ให้เขากดเข้าสู่ระบบอีกครั้ง — เข้าได้ทันที ไม่ต้องรอ
  //
  //  ── วิธีถอนสิทธิ์ ────────────────────────────────────────
  //     ลบโหนดของคนนั้นใต้ allowlist — มีผลทันทีทุกเครื่อง
  //     ถ้าต้องการปิดบัญชีถาวร: Authentication → Users → ⋮ → Disable
  //
  //  ── ถ้าภายหลังอยากให้ทุกคนใน @psu.ac.th เข้าได้เอง ──────────
  //     เติมต่อท้ายเงื่อนไข .read และ .write ให้เหมือนกันทั้งคู่:
  //        || auth.token.email.toLowerCase().endsWith('@psu.ac.th')
  //
  // ============================================================
  "rules": {
    // ปิดทุกอย่างที่ไม่ได้ระบุไว้อย่างชัดเจน
    ".read": false,
    ".write": false,

    "allowlist": {
      // แก้ไขได้จาก Firebase Console เท่านั้น หน้าเว็บเขียนไม่ได้
      ".write": false,
      "$uid": {
        // ให้แต่ละคนอ่านสถานะอนุมัติของตัวเองได้ เพื่อให้แอปบอกได้ว่า
        // "ยังไม่ได้รับอนุมัติ" แทนที่จะขึ้น permission denied ลอย ๆ
        ".read": "auth != null && auth.uid == $uid",
        ".validate": "newData.isBoolean()"
      }
    },

    "data": {
      ".read":  "auth != null && auth.token.email_verified == true && root.child('allowlist').child(auth.uid).val() == true",
      ".write": "auth != null && auth.token.email_verified == true && root.child('allowlist').child(auth.uid).val() == true",

      "projects": {
        "$projectId": {
          // ข้อมูลโครงการต้องเป็นอ็อบเจกต์ที่มี id ตรงกับคีย์ (กันข้อมูลผิดรูปแบบ)
          ".validate": "newData.hasChild('id') && newData.child('id').val() == $projectId"
        }
      },

      "updatedAt": {
        ".validate": "newData.isString()"
      }
    }
  }
}
