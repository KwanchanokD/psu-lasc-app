{
  // ============================================================
  //  กฎความปลอดภัยของ Realtime Database — โปรเจกต์ psu-lasc-animal
  //  ติดตั้ง: Firebase Console → Realtime Database → แท็บ Rules
  //           วางทับของเดิม → กด Publish
  // ============================================================
  //
  //  โหมด: อนุมัติเป็นรายคน
  //  เข้าถึงข้อมูลได้ก็ต่อเมื่อ  ยืนยันอีเมลแล้ว  และ  มีชื่ออยู่ใต้โหนด allowed
  //  ไม่มีใครเข้าได้เอง แม้จะใช้อีเมล @psu.ac.th ก็ตาม
  //
  //  ⚠️ ก่อนกด Publish ตรวจให้แน่ใจว่า UID ของตัวเองอยู่ใต้ allowed แล้ว
  //
  //  ── วิธีอนุมัติคนเข้าใช้งาน ────────────────────────────────
  //     1. ให้เขากดเข้าสู่ระบบ 1 ครั้ง หน้าจอจะขึ้น User UID พร้อมปุ่มคัดลอก
  //        (หรือดูเองที่ Authentication → Users คอลัมน์ User UID)
  //     2. Realtime Database → แท็บ Data → กด + ใต้โหนด allowed
  //              allowed / <User UID>  :  true
  //     3. ให้เขากดเข้าสู่ระบบอีกครั้ง — เข้าได้ทันที
  //
  //  ── วิธีถอนสิทธิ์ ────────────────────────────────────────
  //     ลบโหนดของคนนั้นใต้ allowed  (มีผลทันทีทุกเครื่อง)
  //     ห้ามแก้ค่าเป็น false เฉย ๆ ให้ลบทิ้งไปเลย จะชัดเจนกว่า
  //
  //  ── ถ้าภายหลังอยากให้ทุกคนใน @psu.ac.th เข้าได้เอง ──────────
  //     เติมต่อท้ายเงื่อนไข .read และ .write ให้เหมือนกันทั้งคู่:
  //        || auth.token.email.toLowerCase().endsWith('@psu.ac.th')
  //
  // ============================================================
  "rules": {
    // ปิดทุกอย่างที่ไม่ได้ระบุไว้อย่างชัดเจน
    ".read": false,
    ".write": false,

    "allowed": {
      // แก้ไขได้จาก Firebase Console เท่านั้น หน้าเว็บเขียนไม่ได้
      ".write": false,
      "$uid": {
        // ให้แต่ละคนอ่านสถานะอนุมัติของตัวเองได้ เพื่อให้แอปบอกได้ว่า
        // "ยังไม่ได้รับอนุมัติ" แทนที่จะขึ้น permission denied ลอย ๆ
        ".read": "auth != null && auth.uid == $uid"
      }
    },

    "data": {
      ".read":  "auth != null && auth.token.email_verified == true && root.child('allowed').child(auth.uid).exists() && root.child('allowed').child(auth.uid).val() != false",
      ".write": "auth != null && auth.token.email_verified == true && root.child('allowed').child(auth.uid).exists() && root.child('allowed').child(auth.uid).val() != false",

      "projects": {
        "$projectId": {
          // ข้อมูลโครงการต้องเป็นอ็อบเจกต์ที่มี id ตรงกับคีย์ (กันข้อมูลผิดรูปแบบ)
          ".validate": "newData.hasChild('id') && newData.child('id').val() == $projectId"
        }
      },

      "updatedAt": {
        ".validate": "newData.isString()"
      }
    }
  }
}
